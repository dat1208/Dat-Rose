{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dat-Rose",
  "version": "0.1.10",
  "identifier": "com.dchanger.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dat-Rose",
        "width": 900,
        "height": 620,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "dchanger-backend": "dchanger-backend"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dat1208/Dat-Rose/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBNjhBQTUzMDNDQjFFNzUKUldSMUhzc0RVNnBvK21DaXhKUTVvZU4zTUtDN3dRLzRySCtHNWdaQXlkaUQ3M2c5NUM3d2xERHoK"
    }
  }
}
